  "components": {
    "schemas": {
      "Bin": {
        "properties": {
          "bin_id": {
            "type": "string",
            "title": "Bin Id"
          },
          "building_id": {
            "type": "string",
            "title": "Building Id"
          },
          "lat": {
            "type": "number",
            "title": "Lat"
          },
          "lon": {
            "type": "number",
            "title": "Lon"
          },
          "capacity_l": {
            "type": "integer",
            "title": "Capacity L"
          },
          "category": {
            "$ref": "#/components/schemas/WasteCategory"
          },
          "fill_pct": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Fill Pct"
          },
          "risk_overflow": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Risk Overflow",
            "description": "P(overflow within horizon)"
          },
          "risk_level": {
            "$ref": "#/components/schemas/RiskLevel"
          },
          "last_reading_ts": {
            "type": "string",
            "format": "date-time",
            "title": "Last Reading Ts"
          }
        },
        "type": "object",
        "required": [
          "bin_id",
          "building_id",
          "lat",
          "lon",
          "capacity_l",
          "category",
          "fill_pct",
          "risk_overflow",
          "risk_level",
          "last_reading_ts"
        ],
        "title": "Bin"
      },
      "BuildingComparison": {
        "properties": {
          "building_id": {
            "type": "string",
            "title": "Building Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "kg_period": {
            "type": "number",
            "title": "Kg Period"
          },
          "kg_per_person_day": {
            "type": "number",
            "title": "Kg Per Person Day"
          },
          "wow_change_pct": {
            "type": "number",
            "title": "Wow Change Pct"
          },
          "segregation_pct": {
            "type": "number",
            "title": "Segregation Pct"
          },
          "recycling_pct": {
            "type": "number",
            "title": "Recycling Pct"
          },
          "rank": {
            "type": "integer",
            "title": "Rank"
