# copy to .env (never commit .env)
USE_MOCKS=false
REAL_ENDPOINTS=              # comma list to flip individual endpoints to real: bins,readings,forecast,routes,kpis
API_BASE_URL=http://localhost:8000/api/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash       # must support generateContent for this key
LLM_CACHE=.cache/llm.json
DB_PATH=data/waste.db
VITE_API_BASE=http://localhost:8000/api/v1
